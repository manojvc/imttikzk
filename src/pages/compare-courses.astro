---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BatchBanner from '@components/BatchBanner.astro';
import facts from '@data/facts.json';

const { courses, centre } = facts;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is the difference between Diploma and PG Diploma in Montessori?', acceptedAnswer: { '@type': 'Answer', text: 'The Diploma (6 months) is open from 10th pass and covers 6 theory papers and 20 apparatus. The PG Diploma (1 year or 6-month crash) requires Plus Two or Degree, covers 8 theory papers and 40 apparatus, and additionally includes UK CACHE Level 3 certification.' } },
    { '@type': 'Question', name: 'Which Montessori course is best for Gulf jobs?', acceptedAnswer: { '@type': 'Answer', text: 'The PG Diploma (1 year or 6-month crash course) is recommended for Gulf employment. It includes UK CACHE Level 3 certification which is widely recognised in the Gulf, plus embassy attestation.' } },
    { '@type': 'Question', name: 'Should I choose the 1-year or 6-month PG Diploma in Montessori?', acceptedAnswer: { '@type': 'Answer', text: 'Both lead to the same PG Diploma credential. Choose the 1-year if you want a thorough pace with 5 chart & album works. Choose the 6-month crash course if you need to qualify faster and are comfortable with an intensive schedule.' } },
  ],
};
---

<BaseLayout
  title="Compare Montessori Courses – Diploma vs PG Diploma | IMTTI Kazhakkoottam"
  description="Compare all three Montessori courses at IMTTI Kazhakkoottam – Diploma (6 months), PG Diploma (1 year), PG Diploma crash course (6 months). Duration, syllabus, eligibility, certifications."
  schema={faqSchema}
>
  <BatchBanner slot="header" />
  <Header slot="header" />

  <section class="py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-brand-700">Home</a></li><li>›</li>
          <li class="text-gray-900 font-medium">Compare Courses</li>
        </ol>
      </nav>
      <div class="text-center mb-10">
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Diploma vs PG Diploma in Montessori – Which to Choose?</h1>
        <p class="text-gray-600 max-w-2xl mx-auto">
          IMTTI Kazhakkoottam offers three Montessori teaching courses at different levels. Here is a full side-by-side comparison to help you pick the right one.
        </p>
      </div>

      <!-- Comparison table -->
      <div class="overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-brand-900 text-white">
              <th class="text-left px-5 py-4 font-semibold w-40">Feature</th>
              {courses.map((c) => (
                <th class="text-center px-5 py-4 font-semibold">{c.shortName}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {[
              ['Duration', ...courses.map(c => c.duration)],
              ['Eligibility', ...courses.map(c => c.eligibility)],
              ['Theory papers', ...courses.map(c => `${c.syllabus.theoryPapers}`)],
              ['Apparatus', ...courses.map(c => `${c.syllabus.apparatus}`)],
              ['Chart & album works', ...courses.map(c => c.syllabus.chartAlbumWorks ? `${c.syllabus.chartAlbumWorks}` : '—')],
              ['Teaching practice', ...courses.map(c => c.syllabus.teachingPractice)],
              ['IAO-USA certification', '✓', '✓', '✓'],
              ['UK CACHE Level 3', '✓', '✓', '—'],
              ['Embassy attestation', '✓', '✓', '✓'],
              ['Mode', 'Offline & Online', 'Offline & Online', 'Offline & Online'],
            ].map(([label, ...vals], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-5 py-3.5 font-medium text-gray-700 border-b border-gray-100">{label}</td>
                {vals.map((v, j) => (
                  <td class={`px-5 py-3.5 text-center border-b border-gray-100 ${j === 0 ? 'text-brand-700 font-semibold' : 'text-gray-600'}`}>{v}</td>
                ))}
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="bg-gray-50">
              <td class="px-5 py-4 font-semibold text-gray-700">Details</td>
              {courses.map((c) => (
                <td class="px-5 py-4 text-center">
                  <a href={`/courses/${c.slug}/`} class="inline-block px-4 py-2 bg-brand-700 text-white text-xs font-bold rounded-lg hover:bg-brand-800 transition-colors">View Course</a>
                </td>
              ))}
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Recommendation guide -->
      <div class="mt-12 grid sm:grid-cols-3 gap-6">
        {[
          { who: 'Choose PG Diploma (1 year) if…', items: ['You want maximum depth and 5 chart/album works', 'You\'re aiming for top Montessori schools in India or abroad', 'You have time for a full year of study'] },
          { who: 'Choose PG Diploma (6 months) if…', items: ['You need the full PG credential quickly', 'You\'re a Gulf-bound candidate with a job offer pending', 'You can handle an intensive pace'] },
          { who: 'Choose Diploma (6 months) if…', items: ['Your highest qualification is 10th or 12th pass', 'You\'re exploring Montessori for the first time', 'You want to start teaching at a local preschool soon'] },
        ].map(({ who, items }) => (
          <div class="bg-brand-50 border border-brand-200 rounded-2xl p-6">
            <h3 class="font-semibold text-brand-800 mb-3 text-sm">{who}</h3>
            <ul class="space-y-2">
              {items.map((item) => (
                <li class="flex items-start gap-2 text-sm text-brand-700">
                  <svg class="w-4 h-4 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- FAQ -->
      <div class="mt-14 max-w-3xl mx-auto">
        <h2 class="font-display text-2xl font-bold text-gray-900 mb-6">FAQ</h2>
        <dl class="space-y-3">
          {faqSchema.mainEntity.map((faq) => (
            <div class="border border-gray-200 rounded-xl overflow-hidden">
              <dt>
                <button class="w-full flex items-center justify-between px-5 py-4 text-left font-semibold text-sm text-gray-900 hover:bg-gray-50 faq-toggle" aria-expanded="false">
                  <span>{faq.name}</span>
                  <svg class="w-4 h-4 text-gray-400 shrink-0 faq-icon transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </button>
              </dt>
              <dd class="hidden px-5 pb-4 text-sm text-gray-600 leading-relaxed faq-answer">{faq.acceptedAnswer.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</BaseLayout>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('div')?.querySelector('.faq-answer')?.classList.toggle('hidden');
      btn.querySelector('.faq-icon')?.classList.toggle('rotate-180');
    });
  });
</script>
