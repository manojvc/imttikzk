---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BatchBanner from '@components/BatchBanner.astro';
import Schema from '@components/Schema.astro';
import facts from '@data/facts.json';

const { centre, brand, courses, benefits } = facts;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Where is IMTTI Kazhakkoottam located?',           acceptedAnswer: { '@type': 'Answer', text: 'ASRA 118, Attinkuzhy Road, Kazhakkoottam, Thiruvananthapuram, Kerala 695301 – near Technopark.' } },
    { '@type': 'Question', name: 'What courses are available?',                       acceptedAnswer: { '@type': 'Answer', text: 'Three Montessori courses: PG Diploma 1 year, PG Diploma 6-month crash course, Diploma 6 months. All offline and online.' } },
    { '@type': 'Question', name: 'What certifications do I get?',                     acceptedAnswer: { '@type': 'Answer', text: 'IAO-USA international certification and UK CACHE Level 3. Embassy attestation available for Gulf employment.' } },
    { '@type': 'Question', name: 'Is the Montessori course available online?',        acceptedAnswer: { '@type': 'Answer', text: 'Yes. All three courses are available offline (Kazhakkoottam centre) and online.' } },
    { '@type': 'Question', name: 'What is the eligibility for the PG Diploma?',      acceptedAnswer: { '@type': 'Answer', text: 'Plus Two / Degree / Masters. For the Diploma, eligibility starts from 10th pass.' } },
  ],
};
---

<BaseLayout
  title="Montessori Teacher Training in Kazhakkoottam | IMTTI"
  description="IMTTI Kazhakkoottam – internationally accredited Montessori teacher training (Diploma & PG Diploma) near Technopark, Trivandrum. IAO-USA + UK CACHE Level 3. Call or WhatsApp to enquire."
  schema={faqSchema}
>
  <BatchBanner slot="header" />
  <Header slot="header" />

  <!-- ══════════════════════════════════════
       HERO – parallax photo + dark overlay
  ══════════════════════════════════════ -->
  <section
    class="relative min-h-[88vh] flex items-center hero-parallax"
    style="background-image: url('/images/hero-classroom.jpg');"
  >
    <!-- gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-brand-950/95 via-brand-900/85 to-brand-800/60"></div>

    <!-- floating Montessori SVG decorations -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <!-- Tower blocks -->
      <svg class="absolute right-8 top-16 opacity-20 float-a hidden lg:block" width="120" height="160" viewBox="0 0 120 160">
        <rect x="10" y="0"  width="100" height="20" rx="4" fill="#ffd700"/>
        <rect x="18" y="26" width="84"  height="20" rx="4" fill="#c4961a"/>
        <rect x="26" y="52" width="68"  height="20" rx="4" fill="#ffd700"/>
        <rect x="34" y="78" width="52"  height="20" rx="4" fill="#c4961a"/>
        <rect x="42" y="104" width="36" height="20" rx="4" fill="#ffd700"/>
        <rect x="50" y="130" width="20" height="20" rx="4" fill="#c4961a"/>
      </svg>
      <!-- Bead chain -->
      <svg class="absolute right-56 bottom-24 opacity-15 float-b hidden xl:block" width="200" height="40" viewBox="0 0 200 40">
        {[0,40,80,120,160].map((x) => (
          <circle cx={x+20} cy="20" r="16" fill="#ffd700" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
        ))}
      </svg>
      <!-- Dots -->
      <div class="absolute top-1/4 right-1/3 w-3 h-3 rounded-full bg-gold-500 opacity-30 float-c"></div>
      <div class="absolute top-2/3 left-10 w-5 h-5 rounded-full bg-gold-700 opacity-20 float-a"></div>
      <div class="absolute bottom-1/4 right-1/4 w-2 h-2 rounded-full bg-gold-400 opacity-25 float-b"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 w-full">
      <div class="max-w-2xl">
        <!-- Tagline pill -->
        <div class="inline-flex items-center gap-2 bg-gold-500/15 border border-gold-500/40 rounded-full px-4 py-1.5 mb-6 animate-fade-in-up">
          <span class="w-2 h-2 rounded-full bg-gold-500"></span>
          <span class="text-gold-400 text-sm font-semibold tracking-wide">International Montessori Teacher Training · Est. {brand.established}</span>
        </div>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6"
            style="animation: fadeInUp 0.7s ease 0.1s both;">
          Montessori Teacher Training in
          <span class="text-gold-500"> Kazhakkoottam</span>
        </h1>

        <p class="text-brand-100 text-lg leading-relaxed mb-8"
           style="animation: fadeInUp 0.7s ease 0.25s both;">
          IMTTI Kazhakkoottam offers internationally certified Montessori teacher training – PG Diploma (1 year &amp; 6-month crash) and Diploma (6 months) – near Technopark, Trivandrum. <strong class="text-white">IAO-USA + UK CACHE Level 3</strong> certified, with embassy attestation for Gulf jobs. Offline &amp; online.
        </p>

        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-4 mb-10" style="animation: fadeInUp 0.7s ease 0.4s both;">
          <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 px-7 py-3.5 bg-green-500 hover:bg-green-400 text-white font-bold rounded-xl transition-colors shadow-lg text-sm">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp to Enquire
          </a>
          <a href={`tel:${centre.phones.calls}`}
             class="inline-flex items-center gap-2 px-7 py-3.5 bg-gold-500 hover:bg-gold-400 text-brand-900 font-bold rounded-xl transition-colors shadow-lg text-sm">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call to Enquire
          </a>
          <a href="/courses/"
             class="inline-flex items-center gap-2 px-7 py-3.5 border-2 border-white/40 text-white font-semibold rounded-xl hover:border-gold-400 hover:text-gold-400 transition-colors text-sm">
            View Courses →
          </a>
        </div>

        <!-- Trust badges -->
        <div class="flex flex-wrap gap-3" style="animation: fadeInUp 0.7s ease 0.55s both;">
          {['IAO-USA Certified', 'UK CACHE Level 3', 'Embassy Attestation', 'Since 2004', 'ISO 9001:2018'].map((b) => (
            <span class="flex items-center gap-1.5 bg-white/10 border border-white/20 text-white/80 text-xs font-medium px-3 py-1.5 rounded-full backdrop-blur-sm">
              <svg class="w-3.5 h-3.5 text-gold-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              {b}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom wave -->
    <div class="absolute bottom-0 left-0 right-0 wave-divider">
      <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,40 C360,80 1080,0 1440,40 L1440,60 L0,60 Z" fill="#ffffff"/>
      </svg>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       STATS BAR
  ══════════════════════════════════════ -->
  <section class="bg-white py-10 shadow-sm">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="stagger grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        {[
          ['Since', '2004', 'National brand established'],
          ['3', 'Courses', 'Diploma to PG level'],
          ['40+', 'Apparatus', 'Hands-on practical training'],
          ['100%', 'Placement', 'Job placement assistance'],
        ].map(([top, mid, sub]) => (
          <div class="flex flex-col items-center">
            <div class="text-sm text-gray-500 font-medium">{top}</div>
            <div class="shimmer-gold font-display font-bold text-4xl my-1">{mid}</div>
            <div class="text-xs text-gray-500">{sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       COURSES
  ══════════════════════════════════════ -->
  <section class="py-20 bg-brand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <p class="text-gold-700 font-semibold text-sm uppercase tracking-widest mb-2">Our Programmes</p>
        <h2 class="font-display text-4xl font-bold text-brand-700 mb-3 gold-line">Montessori Teacher Training Courses</h2>
        <p class="text-gray-600 max-w-2xl mx-auto mt-4">Three pathways from 10th pass to Degree level. All carry IAO-USA + UK CACHE Level 3 certifications and job placement assistance.</p>
      </div>

      <div class="stagger grid md:grid-cols-3 gap-7">
        {courses.map((c, i) => (
          <article class={`relative bg-white rounded-2xl overflow-hidden card-lift border-2 ${i === 0 ? 'border-gold-500' : 'border-gray-100'} shadow-sm`}>
            {i === 0 && (
              <div class="bg-gold-500 text-brand-900 text-xs font-bold text-center py-1.5 tracking-wider uppercase">Most Popular</div>
            )}
            <div class="img-zoom h-44">
              <img
                src={i === 0 ? '/images/montessori-materials.jpg' : i === 1 ? '/images/teacher-student.jpg' : '/images/children-learning.jpg'}
                alt={c.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <div class="flex gap-2 flex-wrap mb-3">
                <span class="bg-brand-50 text-brand-700 text-xs font-bold px-2 py-0.5 rounded-full border border-brand-200">{c.duration}</span>
                {c.modes.map((m) => <span class="bg-gray-100 text-gray-600 text-xs px-2 py-0.5 rounded-full capitalize">{m}</span>)}
              </div>
              <h3 class="font-display font-bold text-brand-700 text-lg leading-snug mb-2">{c.shortName}</h3>
              <p class="text-sm text-gray-600 mb-2">{c.highlight}</p>
              <p class="text-xs text-gray-500 mb-5">Eligibility: {c.eligibility}</p>
              <a href={`/courses/${c.slug}/`}
                 class={`block w-full text-center py-2.5 rounded-xl font-semibold text-sm transition-colors ${i === 0 ? 'bg-brand-700 text-white hover:bg-brand-800' : 'border-2 border-brand-700 text-brand-700 hover:bg-brand-700 hover:text-white'}`}>
                Course Details
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="text-center mt-8 reveal">
        <a href="/compare-courses/" class="inline-flex items-center gap-2 text-brand-700 font-semibold hover:text-gold-700 transition-colors">
          Compare all courses side by side
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       WHY IMTTI KAZHAKKOOTTAM (image split)
  ══════════════════════════════════════ -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="reveal-left">
          <div class="img-zoom rounded-2xl overflow-hidden shadow-xl" style="height:420px;">
            <img src="/images/preschool-class.jpg" alt="IMTTI Kazhakkoottam – Montessori classroom" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
        <div class="reveal-right">
          <p class="text-gold-700 font-semibold text-sm uppercase tracking-widest mb-2">Why Choose Us</p>
          <h2 class="font-display text-4xl font-bold text-brand-700 mb-6 gold-line">Differentiators that Matter</h2>
          <div class="space-y-4">
            {[
              ['🏆', 'IAO-USA + UK CACHE Level 3', 'Dual international certification – recognised by employers across India, the Gulf, Europe and beyond.'],
              ['📋', 'Embassy Attestation', 'Certificate attestation support for Gulf countries (UAE, Qatar, Kuwait, Bahrain).'],
              ['🪵', '40 Montessori Apparatus', 'Unlimited practical hours on all 40 wooden Montessori materials – full mastery, no shortcuts.'],
              ['🎓', 'Placement Assistance', 'Dedicated placement support: referrals, resume help, interview prep.'],
              ['🌐', 'Offline & Online', 'Same syllabus, same certification whether you attend in person or online.'],
              ['📍', 'Near Technopark', 'Convenient for residents of Kazhakkoottam, Sreekaryam, Kaniyapuram, Attingal and Trivandrum.'],
            ].map(([icon, title, body]) => (
              <div class="flex gap-4 items-start">
                <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center text-xl shrink-0">{icon}</div>
                <div>
                  <div class="font-semibold text-brand-700 text-sm mb-0.5">{title}</div>
                  <div class="text-gray-600 text-sm leading-relaxed">{body}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       BENEFITS (dark navy strip)
  ══════════════════════════════════════ -->
  <section class="py-16 bg-brand-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <p class="text-gold-400 text-sm font-semibold uppercase tracking-widest mb-2">Every Course Includes</p>
        <h2 class="font-display text-3xl font-bold text-white">What You Get with Every IMTTI Course</h2>
      </div>
      <ul class="stagger grid sm:grid-cols-2 lg:grid-cols-3 gap-3 max-w-5xl mx-auto">
        {benefits.map((b) => (
          <li class="flex items-start gap-3 bg-brand-800/50 rounded-xl px-4 py-3 text-sm text-brand-100">
            <svg class="w-4 h-4 text-gold-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            {b}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       CERTIFICATIONS (image + badges)
  ══════════════════════════════════════ -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="reveal-left">
          <p class="text-gold-700 font-semibold text-sm uppercase tracking-widest mb-2">Globally Recognised</p>
          <h2 class="font-display text-4xl font-bold text-brand-700 mb-4 gold-line">Certifications & Accreditations</h2>
          <p class="text-gray-600 mb-8 leading-relaxed">
            IMTTI Kazhakkoottam courses carry the credentials that actually open doors — IAO-USA, UK CACHE Level 3, and embassy attestation for Gulf employment. Part of a national network that is ISO 9001:2018 certified.
          </p>
          <div class="grid grid-cols-2 gap-4">
            {[
              { badge: 'IAO-USA', title: 'International Accreditation Org.', sub: 'USA-based independent accreditation' },
              { badge: 'CACHE L3', title: 'UK CACHE Level 3', sub: 'PG Diploma courses · Gulf-recognised' },
              { badge: 'Attestation', title: 'Embassy Attestation', sub: 'Gulf visa & employment ready' },
              { badge: 'ISO 9001', title: 'ISO 9001:2018', sub: 'National IMTTI brand standard' },
            ].map(({ badge, title, sub }) => (
              <div class="bg-brand-50 border border-brand-100 rounded-xl p-4 card-lift">
                <div class="inline-block bg-brand-700 text-gold-500 text-xs font-bold px-2 py-0.5 rounded-full mb-2">{badge}</div>
                <div class="font-semibold text-brand-700 text-sm leading-snug">{title}</div>
                <div class="text-gray-500 text-xs mt-0.5">{sub}</div>
              </div>
            ))}
          </div>
          <a href="/certification/" class="inline-flex items-center gap-2 mt-6 text-brand-700 font-semibold hover:text-gold-700 transition-colors text-sm">
            Learn about all certifications →
          </a>
        </div>
        <div class="reveal-right">
          <div class="img-zoom rounded-2xl overflow-hidden shadow-xl" style="height:420px;">
            <img src="/images/certificate-award.jpg" alt="Montessori teacher certification" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       NATIONAL BRAND + QUOTE
  ══════════════════════════════════════ -->
  <section class="py-16 bg-brand-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="reveal mb-8">
        <img src="/images/imtti-logo.jpg" alt="IMTTI – International Montessori Teacher Training Institute" class="h-24 w-auto object-contain mx-auto rounded-xl shadow-sm" loading="lazy"/>
      </div>
      <div class="reveal">
        <p class="text-gray-600 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
          Part of the <strong class="text-brand-700">IMTTI national network</strong> – established {brand.established}, headquartered in Karnataka, with 650+ centres across India and 16+ centres in Kerala. {brand.iso} certified and recognised by {brand.accreditations.slice(0,3).join(', ')}, and more.
        </p>
        <blockquote class="relative max-w-xl mx-auto">
          <svg class="w-10 h-10 text-gold-400 mx-auto mb-3" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          <p class="font-display text-2xl text-brand-700 italic">"{brand.quote}"</p>
          <footer class="text-sm text-gray-500 mt-3">— {brand.quoteAuthor}</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       CAREER PATHS
  ══════════════════════════════════════ -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="reveal">
          <p class="text-gold-700 font-semibold text-sm uppercase tracking-widest mb-2">Career Outcomes</p>
          <h2 class="font-display text-4xl font-bold text-brand-700 mb-6 gold-line">Where IMTTI Graduates Work</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {[
              ['🏫', 'Montessori Schools – India', 'CBSE, ICSE and State Board schools with Montessori wings.'],
              ['🌍', 'Gulf & International', 'UAE, Qatar, Kuwait, Bahrain – CACHE L3 + attestation meets requirements.'],
              ['🧒', 'Kindergartens & Preschools', 'Private preschool chains across Kerala and India.'],
              ['🏡', 'Own Preschool', 'Start and run your own Montessori school or playgroup.'],
            ].map(([icon, title, body]) => (
              <div class="bg-brand-50 rounded-xl p-4 border border-brand-100 card-lift">
                <div class="text-2xl mb-2">{icon}</div>
                <div class="font-semibold text-brand-700 text-sm mb-1">{title}</div>
                <div class="text-gray-600 text-xs leading-relaxed">{body}</div>
              </div>
            ))}
          </div>
          <a href="/placements/" class="inline-flex items-center gap-2 mt-6 text-brand-700 font-semibold hover:text-gold-700 transition-colors text-sm">
            View placement details →
          </a>
        </div>
        <div class="reveal">
          <div class="img-zoom rounded-2xl overflow-hidden shadow-xl" style="height:420px;">
            <img src="/images/wooden-blocks.jpg" alt="Montessori teaching materials" class="w-full h-full object-cover" loading="lazy"/>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       FAQ
  ══════════════════════════════════════ -->
  <section class="py-16 bg-brand-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="font-display text-3xl font-bold text-brand-700">Frequently Asked Questions</h2>
      </div>
      <dl class="stagger space-y-3">
        {faqSchema.mainEntity.map((faq) => (
          <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
            <dt>
              <button class="w-full flex items-center justify-between px-5 py-4 text-left font-semibold text-gray-900 hover:bg-brand-50 transition-colors faq-toggle" aria-expanded="false">
                <span class="text-sm">{faq.name}</span>
                <svg class="w-4 h-4 text-brand-700 shrink-0 faq-icon transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
            </dt>
            <dd class="hidden px-5 pb-4 text-sm text-gray-600 leading-relaxed faq-answer">{faq.acceptedAnswer.text}</dd>
          </div>
        ))}
      </dl>
      <div class="text-center mt-6 reveal">
        <a href="/faq/" class="text-brand-700 font-semibold hover:text-gold-700 transition-colors text-sm">View all FAQs →</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       CONTACT CTA STRIP (no form)
  ══════════════════════════════════════ -->
  <section class="py-16 bg-brand-700 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
      <svg class="absolute -right-10 -top-10 float-a" width="250" height="250" viewBox="0 0 250 250"><circle cx="125" cy="125" r="125" fill="#ffd700"/></svg>
      <svg class="absolute -left-10 -bottom-10 float-b" width="180" height="180" viewBox="0 0 180 180"><circle cx="90" cy="90" r="90" fill="#ffd700"/></svg>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="reveal">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-white mb-3">Ready to Begin Your Montessori Journey?</h2>
        <p class="text-brand-200 text-lg mb-8">Enquire about courses, admissions, fees, and batch dates by calling or WhatsApp.</p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 px-8 py-4 bg-green-500 hover:bg-green-400 text-white font-bold rounded-xl transition-colors shadow-lg">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp: {centre.phones.whatsappDisplay}
          </a>
          <a href={`tel:${centre.phones.calls}`}
             class="inline-flex items-center gap-2 px-8 py-4 bg-gold-500 hover:bg-gold-400 text-brand-900 font-bold rounded-xl transition-colors shadow-lg">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call: {centre.phones.callsDisplay}
          </a>
          <a href="/contact/"
             class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white/40 text-white font-semibold rounded-xl hover:border-gold-400 hover:text-gold-400 transition-colors">
            More Ways to Reach Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
  <Schema />
</BaseLayout>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const exp = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!exp));
      btn.closest('div')?.querySelector('.faq-answer')?.classList.toggle('hidden');
      btn.querySelector('.faq-icon')?.classList.toggle('rotate-180');
    });
  });
</script>
