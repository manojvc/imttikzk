---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BatchBanner from '@components/BatchBanner.astro';
import facts from '@data/facts.json';

const { centre } = facts;
---

<BaseLayout
  title="Contact IMTTI Kazhakkoottam – Phone, WhatsApp & Location"
  description="Contact IMTTI Kazhakkoottam for Montessori course enquiries. Call +91 99611 70788 (WhatsApp) or +91 99956 80078. ASRA 118, Attinkuzhy Road, Kazhakkoottam, Trivandrum 695301."
>
  <BatchBanner slot="header" />
  <Header slot="header" />

  <!-- Hero strip -->
  <section class="bg-brand-700 text-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl font-bold mb-3">Contact Us</h1>
      <p class="text-brand-200 text-lg">We respond quickly during working hours. Call or WhatsApp for the fastest response.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 items-start">

        <!-- Contact card -->
        <div class="reveal space-y-5">
          <div class="bg-white border border-gray-200 rounded-2xl p-7 shadow-sm">
            <h2 class="font-display text-xl font-bold text-brand-700 mb-5 gold-line">IMTTI Kazhakkoottam</h2>
            <address class="not-italic space-y-5 text-sm mt-6">

              <div class="flex gap-3 items-start">
                <div class="w-9 h-9 rounded-xl bg-brand-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </div>
                <div>
                  <div class="font-semibold text-gray-900">{centre.address.streetAddress}</div>
                  <div class="text-gray-600">{centre.address.addressLocality}, {centre.address.addressRegion} {centre.address.postalCode}</div>
                  {centre.mapsUrl !== '{{TBD}}' && (
                    <a href={centre.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:text-gold-700 text-xs mt-1 inline-block font-medium transition-colors">Get Directions →</a>
                  )}
                </div>
              </div>

              <div class="flex gap-3 items-start">
                <div class="w-9 h-9 rounded-xl bg-green-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-green-600" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </div>
                <div>
                  <div class="text-xs text-gray-500 font-medium mb-0.5">WhatsApp</div>
                  <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer" class="font-semibold text-green-700 hover:text-green-600 transition-colors">{centre.phones.whatsappDisplay}</a>
                </div>
              </div>

              <div class="flex gap-3 items-start">
                <div class="w-9 h-9 rounded-xl bg-brand-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </div>
                <div>
                  <div class="text-xs text-gray-500 font-medium mb-0.5">Calls</div>
                  <a href={`tel:${centre.phones.calls}`} class="font-semibold text-brand-700 hover:text-gold-700 transition-colors">{centre.phones.callsDisplay}</a>
                </div>
              </div>

              <div class="flex gap-3 items-start">
                <div class="w-9 h-9 rounded-xl bg-brand-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <div>
                  <div class="text-xs text-gray-500 font-medium mb-0.5">Email</div>
                  <a href={`mailto:${centre.email}`} class="font-semibold text-brand-700 hover:text-gold-700 transition-colors">{centre.email}</a>
                </div>
              </div>

              <div class="flex gap-3 items-start">
                <div class="w-9 h-9 rounded-xl bg-brand-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                  <div class="text-xs text-gray-500 font-medium mb-0.5">Hours</div>
                  <span class="text-gray-700">{centre.hoursDisplay}</span>
                </div>
              </div>
            </address>
          </div>
        </div>

        <!-- CTA + map placeholder -->
        <div class="reveal space-y-5">
          <div class="bg-brand-700 text-white rounded-2xl p-7">
            <h2 class="font-display text-xl font-bold mb-2">Get in Touch</h2>
            <p class="text-brand-200 text-sm mb-5 leading-relaxed">
              Call or WhatsApp for the fastest response. We'll help you choose the right Montessori course and answer any questions about fees, batch dates, online vs offline, and eligibility.
            </p>
            <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-3 w-full py-3.5 px-4 bg-green-500 hover:bg-green-400 text-white font-bold rounded-xl transition-colors mb-3">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp: {centre.phones.whatsappDisplay}
            </a>
            <a href={`tel:${centre.phones.calls}`}
               class="flex items-center gap-3 w-full py-3.5 px-4 border-2 border-gold-500 text-gold-400 font-bold rounded-xl hover:bg-brand-600 transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call: {centre.phones.callsDisplay}
            </a>
          </div>

          <!-- Map -->
          <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm" style="height:280px;">
            <iframe
              src={centre.mapEmbedUrl}
              width="100%" height="100%"
              class="border-0"
              allowfullscreen loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="IMTTI Kazhakkoottam location map"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</BaseLayout>
