---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BatchBanner from '@components/BatchBanner.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog – Montessori Teaching Guides | IMTTI Kazhakkoottam"
  description="Guides and articles on Montessori teacher training, CACHE Level 3, Gulf career paths, and early childhood education from IMTTI Kazhakkoottam."
>
  <BatchBanner slot="header" />
  <Header slot="header" />

  <!-- Hero strip -->
  <section class="bg-brand-900 text-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl font-bold mb-3">Blog & Guides</h1>
      <p class="text-brand-200 text-lg">In-depth guides on Montessori teaching, certifications, career paths, and early childhood education.</p>
    </div>
  </section>

  <section class="py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-center text-gray-500 py-12">Coming soon – check back for guides on Montessori teacher training, CACHE Level 3, and Gulf career paths.</p>
      ) : (
        <div class="stagger grid sm:grid-cols-2 gap-6">
          {posts.map((post) => (
            <article class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm card-lift flex flex-col">
              <div class="p-6 flex flex-col flex-1">
                <time class="text-xs text-gold-700 font-semibold uppercase tracking-wider" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <h2 class="font-display font-bold text-brand-700 text-lg mt-2 mb-2 leading-snug">
                  <a href={`/blog/${post.slug}/`} class="hover:text-gold-700 transition-colors">{post.data.title}</a>
                </h2>
                <p class="text-sm text-gray-600 leading-relaxed mb-5 flex-1">{post.data.description}</p>
                <a href={`/blog/${post.slug}/`}
                   class="inline-flex items-center gap-1.5 text-brand-700 font-semibold text-sm hover:text-gold-700 transition-colors">
                  Read more
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</BaseLayout>
