---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BatchBanner from '@components/BatchBanner.astro';
import facts from '@data/facts.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const pubDateDisplay = post.data.pubDate.toLocaleDateString('en-IN', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://imttikzk.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://imttikzk.com/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: `https://imttikzk.com/blog/${post.slug}/` },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: 'IMTTI Kazhakkoottam',
    url: 'https://imttikzk.com',
  },
};
---

<BaseLayout
  title={`${post.data.title} | IMTTI Kazhakkoottam Blog`}
  description={post.data.description}
  schema={[breadcrumb, articleSchema]}
>
  <BatchBanner slot="header" />
  <Header slot="header" />

  <!-- Hero strip -->
  <section class="bg-brand-900 text-white py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-brand-300 mb-5" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-gold-400 transition-colors">Home</a></li>
          <li class="text-brand-500">›</li>
          <li><a href="/blog/" class="hover:text-gold-400 transition-colors">Blog</a></li>
          <li class="text-brand-500">›</li>
          <li class="text-white truncate max-w-xs">{post.data.title}</li>
        </ol>
      </nav>
      <div class="text-gold-400 text-xs font-semibold uppercase tracking-widest mb-3">
        {pubDateDisplay} · {post.data.author}
      </div>
      <h1 class="font-display text-3xl sm:text-4xl font-bold leading-tight mb-4">{post.data.title}</h1>
      <p class="text-brand-100 text-lg leading-relaxed">{post.data.description}</p>
    </div>
  </section>

  <!-- Article body -->
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="prose prose-lg max-w-none
      prose-headings:font-display prose-headings:text-brand-700
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-gray-700 prose-p:leading-relaxed
      prose-a:text-brand-700 prose-a:no-underline hover:prose-a:text-gold-700
      prose-strong:text-brand-700
      prose-ul:text-gray-700 prose-ol:text-gray-700
      prose-li:leading-relaxed prose-li:my-1
      prose-table:text-sm
      prose-th:bg-brand-700 prose-th:text-white prose-th:px-4 prose-th:py-2
      prose-td:px-4 prose-td:py-2 prose-td:border prose-td:border-gray-200
      prose-blockquote:border-l-4 prose-blockquote:border-gold-500 prose-blockquote:pl-4 prose-blockquote:text-gray-600">
      <Content />
    </div>

    <!-- Tags -->
    {post.data.keywords && post.data.keywords.length > 0 && (
      <div class="mt-10 pt-6 border-t border-gray-200">
        <div class="flex flex-wrap gap-2">
          {post.data.keywords.map((kw) => (
            <span class="bg-brand-50 text-brand-700 text-xs font-medium px-3 py-1 rounded-full border border-brand-100">{kw}</span>
          ))}
        </div>
      </div>
    )}

    <!-- CTA -->
    <div class="mt-12 bg-brand-700 text-white rounded-2xl p-7">
      <h2 class="font-display text-xl font-bold mb-2">Interested in Montessori Teacher Training?</h2>
      <p class="text-brand-200 text-sm mb-5">IMTTI Kazhakkoottam offers internationally certified Montessori courses (Diploma & PG Diploma) near Technopark, Trivandrum — offline and online. Call or WhatsApp to enquire about the current batch.</p>
      <div class="flex flex-wrap gap-3">
        <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-500 hover:bg-green-400 text-white font-bold rounded-xl text-sm transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp to Enquire
        </a>
        <a href={`tel:${facts.centre.phones.calls}`}
           class="inline-flex items-center gap-2 px-5 py-2.5 bg-gold-500 hover:bg-gold-400 text-brand-900 font-bold rounded-xl text-sm transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call to Enquire
        </a>
        <a href="/courses/" class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-white/40 text-white font-semibold rounded-xl hover:border-gold-400 hover:text-gold-400 transition-colors text-sm">
          View All Courses →
        </a>
      </div>
    </div>

    <!-- Back to blog -->
    <div class="mt-8 text-center">
      <a href="/blog/" class="text-brand-700 font-semibold hover:text-gold-700 transition-colors text-sm">← Back to Blog</a>
    </div>
  </article>

  <Footer slot="footer" />
  <WhatsAppButton />
</BaseLayout>
