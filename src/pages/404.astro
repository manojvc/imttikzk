---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
---

<BaseLayout
  title="Page Not Found | IMTTI Kazhakkoottam"
  description="The page you are looking for could not be found."
  noindex={true}
>
  <Header slot="header" />

  <section class="py-28 text-center">
    <div class="max-w-md mx-auto px-4">
      <div class="text-7xl font-display font-bold text-brand-100 mb-4">404</div>
      <h1 class="font-display text-2xl font-bold text-gray-900 mb-3">Page Not Found</h1>
      <p class="text-gray-600 mb-8">The page you're looking for doesn't exist or has moved.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="px-6 py-3 bg-brand-700 text-white font-semibold rounded-xl hover:bg-brand-800 transition-colors">Go to Home</a>
        <a href="/courses/" class="px-6 py-3 border border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-colors">View Courses</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</BaseLayout>
