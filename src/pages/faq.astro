---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BatchBanner from '@components/BatchBanner.astro';
import facts from '@data/facts.json';

const { centre } = facts;

const faqs = [
  { q: 'Where is IMTTI Kazhakkoottam located?', a: `ASRA 118, Attinkuzhy Road, Kazhakkoottam, Thiruvananthapuram, Kerala 695301 – near Technopark. ${centre.mapsUrl !== '{{TBD}}' ? 'See map on the Contact page.' : ''}` },
  { q: 'What are the working hours?', a: 'Monday–Friday 9:00 am – 6:00 pm; Saturday 9:00 am – 1:00 pm; Sunday closed.' },
  { q: 'Which courses are offered?', a: 'Three Montessori courses: (1) PG Diploma – 1 year, (2) PG Diploma – 6-month crash course, (3) Diploma – 6 months. All available offline and online.' },
  { q: 'When does the next batch start?', a: `Admissions are open on a rolling basis – new batches start as students enrol. Classes run ${centre.currentBatch.classTime}. Contact us on WhatsApp or by phone for the current intake.` },
  { q: 'What is the class timing?', a: `${centre.currentBatch.classTime} for all courses, Monday–Friday, offline and online.` },
  { q: 'What is the eligibility for the Montessori PG Diploma?', a: 'Plus Two / Degree / Masters (10+2 or above).' },
  { q: 'Can I join the Diploma after 10th pass?', a: 'Yes. The International Diploma in Montessori Teaching Practice is open from 10th pass (SSLC).' },
  { q: 'Is the course available online?', a: 'Yes. All three courses are available offline (at the Kazhakkoottam centre) and online. Online students join the same live session.' },
  { q: 'What certifications do I get?', a: 'All courses carry IAO-USA (International Accreditation Organization) certification, UK CACHE Level 3, and iMAC (International Montessori Accreditation Commission) accreditation. Embassy attestation is available for all courses.' },
  { q: 'Is CACHE Level 3 valid for Gulf jobs?', a: 'UK CACHE Level 3, combined with embassy attestation, is accepted for Montessori teaching roles in the UAE, Qatar, Kuwait, Bahrain, and Oman. Confirm current requirements for your specific destination with IMTTI before applying for overseas roles.' },
  { q: 'What is embassy attestation?', a: 'Embassy attestation is government verification of your educational certificate, required for employment in Gulf countries. IMTTI Kazhakkoottam supports its graduates in getting their certificates attested.' },
  { q: 'What is the fee? Do you offer EMI?', a: 'Contact us for the current fee structure. EMI options are available. Call or WhatsApp ' + centre.phones.whatsappDisplay + '.' },
  { q: 'How many Montessori apparatus are covered?', a: '40 Montessori wooden apparatus in the PG Diploma courses; 20 in the Diploma. Training hours are unlimited – students can practice as many times as needed.' },
  { q: 'Is there job placement assistance?', a: 'Yes. 100% placement assistance is included in every course – referrals to partner schools, resume support, and interview preparation.' },
  { q: 'Can I start a preschool after completing the course?', a: 'Absolutely. The PG Diploma courses include comprehensive training in running a Montessori classroom, lesson planning, and child assessment – a strong foundation for starting your own school.' },
  { q: 'Who is IMTTI?', a: `IMTTI (International Montessori Teacher Training Institute) is a national Montessori training brand established in 2004, headquartered in Kolar Gold Fields, Karnataka. It is ISO 9001:2018 certified and IAO-USA accredited. Kazhakkoottam is an authorised IMTTI centre.` },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title="FAQ – Montessori Course Queries | IMTTI Kazhakkoottam"
  description="Frequently asked questions about Montessori teacher training at IMTTI Kazhakkoottam – courses, eligibility, batch dates, fees, certifications, Gulf placements, and more."
  schema={faqSchema}
>
  <BatchBanner slot="header" />
  <Header slot="header" />

  <section class="py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl font-bold text-gray-900 mb-4 text-center">Frequently Asked Questions</h1>
      <p class="text-gray-600 text-center mb-12">Everything you need to know about Montessori teacher training at IMTTI Kazhakkoottam.</p>

      <dl class="space-y-3">
        {faqs.map(({ q, a }) => (
          <div class="border border-gray-200 rounded-xl overflow-hidden">
            <dt>
              <button class="w-full flex items-center justify-between px-5 py-4 text-left font-semibold text-gray-900 hover:bg-gray-50 faq-toggle" aria-expanded="false">
                <span class="text-sm">{q}</span>
                <svg class="w-4 h-4 text-gray-400 shrink-0 faq-icon transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </button>
            </dt>
            <dd class="hidden px-5 pb-4 text-sm text-gray-600 leading-relaxed faq-answer">{a}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-10 text-center bg-brand-50 rounded-2xl p-6">
        <p class="text-gray-700 font-medium mb-3">Still have a question?</p>
        <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-green-600 text-white font-bold rounded-xl hover:bg-green-700 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Ask on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</BaseLayout>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('div')?.querySelector('.faq-answer')?.classList.toggle('hidden');
      btn.querySelector('.faq-icon')?.classList.toggle('rotate-180');
    });
  });
</script>
