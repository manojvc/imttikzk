---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BatchBanner from '@components/BatchBanner.astro';
import facts from '@data/facts.json';

const { centre, courses } = facts;
---

<BaseLayout
  title="Admissions – Montessori Teacher Training | IMTTI Kazhakkoottam"
  description="Join IMTTI Kazhakkoottam's internationally certified Montessori teacher training. PG Diploma (1 year & 6-month crash) and Diploma (6 months), offline & online. Call or WhatsApp to enquire about the current batch."
>
  <BatchBanner slot="header" />
  <Header slot="header" />

  <!-- Hero -->
  <section class="relative bg-brand-900 text-white overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/hero-classroom.jpg" alt="Montessori classroom at IMTTI Kazhakkoottam" class="w-full h-full object-cover opacity-15" />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-950/95 to-brand-900/80"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <div class="inline-flex items-center gap-2 bg-gold-500/15 border border-gold-500/40 rounded-full px-4 py-1.5 mb-5">
        <span class="w-2 h-2 rounded-full bg-gold-500"></span>
        <span class="text-gold-400 text-sm font-semibold">Admissions Open – Offline & Online</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">Join IMTTI Kazhakkoottam</h1>
      <p class="text-brand-100 text-lg max-w-2xl mx-auto">
        Three internationally certified Montessori courses with IAO-USA + UK CACHE Level 3 credentials. Contact us directly for current batch dates, fees and EMI options.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Courses available -->
      <div class="mb-14">
        <div class="text-center mb-8 reveal">
          <h2 class="font-display text-3xl font-bold text-brand-700 gold-line">Courses Available</h2>
        </div>
        <div class="stagger grid md:grid-cols-3 gap-6">
          {courses.map((c) => (
            <div class="bg-white border-2 border-brand-100 rounded-2xl p-6 card-lift shadow-sm">
              <div class="text-gold-600 font-bold text-sm uppercase tracking-wider mb-1">{c.duration}</div>
              <h3 class="font-display font-bold text-brand-700 text-lg leading-snug mb-2">{c.shortName}</h3>
              <p class="text-xs text-gray-500 mb-3">Eligibility: {c.eligibility}</p>
              <p class="text-sm text-gray-600 mb-4">{c.highlight}</p>
              <a href={`/courses/${c.slug}/`} class="text-brand-700 font-semibold text-sm hover:text-gold-700 transition-colors">View course details →</a>
            </div>
          ))}
        </div>
      </div>

      <!-- How to apply + contact -->
      <div class="grid lg:grid-cols-2 gap-10 items-start">

        <!-- Steps -->
        <div class="reveal">
          <h2 class="font-display text-2xl font-bold text-brand-700 mb-6 gold-line">How to Apply</h2>
          <ol class="space-y-5 mt-6">
            {[
              ['Call or WhatsApp us', `Reach us at ${centre.phones.whatsappDisplay} (WhatsApp) or ${centre.phones.callsDisplay} (calls). Ask about the current batch, fees, and schedule.`],
              ['Get course guidance', 'Our team helps you pick the right course based on your qualification, goals, and schedule – Diploma or PG Diploma, offline or online.'],
              ['Confirm your seat', 'Pay the admission fee to reserve your seat in the batch. Limited seats for the offline batch at Kazhakkoottam.'],
              ['Receive joining details', 'Get your orientation information or online login credentials before the batch starts.'],
            ].map(([title, body], i) => (
              <li class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-full bg-brand-700 text-gold-400 font-bold flex items-center justify-center shrink-0 text-sm">{i + 1}</span>
                <div>
                  <div class="font-semibold text-brand-700 text-sm mb-0.5">{title}</div>
                  <div class="text-gray-600 text-sm leading-relaxed">{body}</div>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <!-- Contact CTA card -->
        <div class="reveal">
          <div class="bg-brand-700 text-white rounded-2xl p-8">
            <div class="text-gold-400 font-semibold text-sm uppercase tracking-widest mb-2">Contact Us</div>
            <h2 class="font-display text-2xl font-bold mb-2">Speak to Our Team</h2>
            <p class="text-brand-200 text-sm mb-6 leading-relaxed">
              Call or WhatsApp to ask about batch dates, fees, eligibility, online vs offline, or any other questions. We respond quickly during working hours.
            </p>

            <div class="space-y-3 mb-6">
              <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer"
                 class="flex items-center gap-3 w-full py-3.5 px-4 bg-green-500 hover:bg-green-400 text-white font-bold rounded-xl transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                WhatsApp: {centre.phones.whatsappDisplay}
              </a>
              <a href={`tel:${centre.phones.calls}`}
                 class="flex items-center gap-3 w-full py-3.5 px-4 border-2 border-gold-500 text-gold-400 font-bold rounded-xl hover:bg-brand-600 transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call: {centre.phones.callsDisplay}
              </a>
            </div>

            <div class="text-brand-300 text-xs space-y-1 border-t border-brand-600 pt-4">
              <div>📧 {centre.email}</div>
              <div>🕐 {centre.hoursDisplay}</div>
              <div>📍 {centre.address.streetAddress}, {centre.address.addressLocality}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</BaseLayout>
