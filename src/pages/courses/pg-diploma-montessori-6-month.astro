---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BatchBanner from '@components/BatchBanner.astro';
import facts from '@data/facts.json';

const { centre, benefits } = facts;
const course = facts.courses.find(c => c.id === 'pg-diploma-montessori-6-month')!;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is covered in the 6-month PG Diploma crash course in Montessori?', acceptedAnswer: { '@type': 'Answer', text: '8 theory papers, 40 Montessori apparatus with unlimited practical hours, 2 chart & album works, and 1-month teaching practice – the full PG Diploma content compressed into 6 months.' } },
    { '@type': 'Question', name: 'Is the 6-month crash course equivalent to the 1-year PG Diploma?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Both lead to the same International PG Diploma in Montessori Teaching Practice credential with IAO-USA + UK CACHE Level 3 certification. The crash course covers the same syllabus in an intensive format.' } },
    { '@type': 'Question', name: 'Who should choose the 6-month Montessori PG Diploma crash course?', acceptedAnswer: { '@type': 'Answer', text: 'Degree holders or working professionals who need a full PG Diploma qualification quickly. Also suitable for Gulf-bound candidates who want to complete training before a job posting.' } },
  ],
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',    item: 'https://imttikzk.com/' },
    { '@type': 'ListItem', position: 2, name: 'Courses', item: 'https://imttikzk.com/courses/' },
    { '@type': 'ListItem', position: 3, name: course.shortName, item: `https://imttikzk.com/courses/${course.slug}/` },
  ],
};
---

<BaseLayout
  title="PG Diploma Montessori – 6-Month Crash Course | IMTTI Kazhakkoottam"
  description="International PG Diploma in Montessori Teaching Practice – 6-month crash course at IMTTI Kazhakkoottam. Full PG Diploma credential, IAO-USA + CACHE Level 3, embassy attestation. Call or WhatsApp to enquire."
  schema={[faqSchema, breadcrumb]}
>
  <BatchBanner slot="header" />
  <Header slot="header" />

  <!-- Hero -->
  <section class="relative bg-brand-900 text-white overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/teacher-student.jpg" alt="" class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-950/95 to-brand-900/80"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <nav class="text-sm text-brand-300 mb-5" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-gold-400 transition-colors">Home</a></li><li class="text-brand-500">›</li>
          <li><a href="/courses/" class="hover:text-gold-400 transition-colors">Courses</a></li><li class="text-brand-500">›</li>
          <li class="text-white">{course.shortName}</li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 mb-4 flex-wrap">
          <span class="bg-gold-500 text-brand-900 text-xs font-bold px-3 py-1 rounded-full uppercase">6 Months</span>
          <span class="bg-brand-700/60 text-white text-xs font-bold px-3 py-1 rounded-full border border-brand-600">Crash Course</span>
          <span class="bg-brand-700/60 text-white text-xs font-bold px-3 py-1 rounded-full border border-brand-600">Offline & Online</span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl font-bold mb-4">{course.name}</h1>
        <p class="text-brand-100 text-lg leading-relaxed mb-6">
          Full PG Diploma credentials in 6 months. The crash course covers the complete syllabus – 8 theory papers, 40 apparatus, 2 chart &amp; album works, and teaching practice – leading to the same IAO-USA + UK CACHE Level 3 certification as the 1-year programme. Ideal for professionals and Gulf-bound candidates.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-500 hover:bg-green-400 text-white font-bold rounded-xl text-sm transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp to Enquire
          </a>
          <a href={`tel:${centre.phones.calls}`}
             class="inline-flex items-center gap-2 px-5 py-2.5 bg-gold-500 hover:bg-gold-400 text-brand-900 font-bold rounded-xl text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call to Enquire
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 space-y-10">

        <!-- Quick facts -->
        <div class="stagger grid sm:grid-cols-2 gap-4">
          {[
            ['Duration', course.duration],
            ['Eligibility', course.eligibility],
            ['Class timing', '10:30 am – 12:30 pm'],
            ['Mode', 'Offline & Online'],
            ['Theory papers', `${course.syllabus.theoryPapers} papers`],
            ['Apparatus', `${course.syllabus.apparatus} wooden apparatus`],
          ].map(([label, value]) => (
            <div class="bg-brand-50 border border-brand-100 rounded-xl px-4 py-3">
              <div class="text-xs text-brand-600 font-semibold uppercase tracking-wider">{label}</div>
              <div class="text-brand-900 font-bold mt-0.5">{value}</div>
            </div>
          ))}
        </div>

        <!-- Comparison table -->
        <div class="reveal">
          <h2 class="font-display text-2xl font-bold text-brand-700 mb-4 gold-line">Crash Course vs 1-Year PG Diploma</h2>
          <div class="overflow-x-auto mt-6">
            <table class="w-full text-sm border-collapse rounded-xl overflow-hidden shadow-sm">
              <thead>
                <tr class="bg-brand-700">
                  <th class="text-left px-4 py-3 font-semibold text-brand-100">Component</th>
                  <th class="text-center px-4 py-3 font-semibold text-gold-400">6-Month Crash Course</th>
                  <th class="text-center px-4 py-3 font-semibold text-brand-200">1-Year PG Diploma</th>
                </tr>
              </thead>
              <tbody>
                {[
                  ['Credential', 'PG Diploma', 'PG Diploma'],
                  ['Theory papers', '8', '8'],
                  ['Apparatus', '40', '40'],
                  ['Chart & album works', '2', '5'],
                  ['Teaching practice', '1 month', '1 month'],
                  ['IAO-USA + CACHE L3', '✓', '✓'],
                  ['Embassy attestation', '✓', '✓'],
                ].map(([comp, crash, full], i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-brand-50'}>
                    <td class="px-4 py-3 font-medium text-gray-700 border-b border-gray-100">{comp}</td>
                    <td class="px-4 py-3 text-center text-brand-700 font-bold border-b border-gray-100">{crash}</td>
                    <td class="px-4 py-3 text-center text-gray-600 border-b border-gray-100">{full}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Course image -->
        <div class="img-zoom rounded-2xl overflow-hidden shadow-md" style="height:260px;">
          <img src="/images/children-learning.jpg" alt="Montessori children learning with materials" class="w-full h-full object-cover" loading="lazy" />
        </div>

        <!-- Benefits -->
        <div class="reveal bg-brand-700 rounded-2xl p-6">
          <h2 class="font-display text-xl font-bold text-white mb-4">Course Benefits</h2>
          <ul class="grid sm:grid-cols-2 gap-2.5">
            {benefits.map((b) => (
              <li class="flex items-start gap-2.5 text-sm text-brand-100">
                <svg class="w-4 h-4 text-gold-400 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                {b}
              </li>
            ))}
          </ul>
        </div>

        <!-- FAQ -->
        <div class="reveal">
          <h2 class="font-display text-2xl font-bold text-brand-700 mb-6 gold-line">FAQ</h2>
          <dl class="stagger space-y-3 mt-6">
            {faqSchema.mainEntity.map((faq) => (
              <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
                <dt>
                  <button class="w-full flex items-center justify-between px-5 py-4 text-left font-semibold text-sm text-gray-900 hover:bg-brand-50 faq-toggle transition-colors" aria-expanded="false">
                    <span>{faq.name}</span>
                    <svg class="w-4 h-4 text-brand-700 shrink-0 faq-icon transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                  </button>
                </dt>
                <dd class="hidden px-5 pb-4 text-sm text-gray-600 leading-relaxed faq-answer">{faq.acceptedAnswer.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="sticky top-20 space-y-5">
          <div class="bg-brand-700 text-white rounded-2xl p-6">
            <div class="text-gold-400 font-semibold text-xs uppercase tracking-widest mb-1">Admissions Open</div>
            <div class="font-display text-xl font-bold mb-1">PG Diploma – 6 Months</div>
            <div class="text-brand-200 text-sm mb-5">Crash Course · Offline &amp; Online</div>
            <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer"
               class="flex items-center justify-center gap-2 w-full py-3 bg-green-500 hover:bg-green-400 text-white font-bold rounded-xl transition-colors mb-3 text-sm">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp for Batch Dates
            </a>
            <a href={`tel:${centre.phones.calls}`}
               class="flex items-center justify-center gap-2 w-full py-3 border border-gold-500 text-gold-400 font-bold rounded-xl hover:bg-brand-600 transition-colors text-sm">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call: {centre.phones.callsDisplay}
            </a>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm">
            <h3 class="font-semibold text-brand-700 mb-3 text-sm uppercase tracking-wider">At a Glance</h3>
            <dl class="space-y-2.5 text-sm">
              {[
                ['Duration', '6 Months'],
                ['Eligibility', 'Plus Two / Degree / Masters'],
                ['Mode', 'Offline & Online'],
                ['Certification', 'IAO-USA + CACHE Level 3'],
                ['Attestation', 'Embassy (Gulf) available'],
              ].map(([k, v]) => (
                <div class="flex justify-between gap-2 border-b border-gray-100 pb-2">
                  <dt class="text-gray-500 font-medium">{k}</dt>
                  <dd class="text-brand-700 font-semibold text-right">{v}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="bg-brand-50 border border-brand-100 rounded-2xl p-5">
            <h3 class="font-semibold text-brand-700 mb-3 text-sm">Other Courses</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/courses/pg-diploma-montessori/" class="text-brand-600 hover:text-gold-700 transition-colors">PG Diploma – 1 Year</a></li>
              <li><a href="/courses/diploma-montessori/" class="text-brand-600 hover:text-gold-700 transition-colors">Diploma – 6 Months</a></li>
              <li><a href="/compare-courses/" class="text-brand-600 hover:text-gold-700 transition-colors">Compare All Courses →</a></li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <Footer slot="footer" />
  <WhatsAppButton />
</BaseLayout>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('div')?.querySelector('.faq-answer')?.classList.toggle('hidden');
      btn.querySelector('.faq-icon')?.classList.toggle('rotate-180');
    });
  });
</script>
