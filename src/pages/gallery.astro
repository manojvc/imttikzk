---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BatchBanner from '@components/BatchBanner.astro';
---

<BaseLayout
  title="Gallery – IMTTI Kazhakkoottam Centre"
  description="Photos of the IMTTI Kazhakkoottam Montessori teacher training centre – apparatus room, classrooms, and practical training sessions."
>
  <BatchBanner slot="header" />
  <Header slot="header" />

  <section class="py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl font-bold text-gray-900 mb-4 text-center">Gallery</h1>
      <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">
        Photos of our Kazhakkoottam centre – apparatus room, training sessions, and campus.
      </p>

      <!-- Placeholder grid – replace with actual WebP images from the Kazhakkoottam centre only -->
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 mb-8 text-sm text-amber-800">
        <strong>Note for site admins:</strong> Replace the placeholder cards below with actual photos from the Kazhakkoottam centre only. Do not use photos from the Thrissur or Kodungallur centres. All images must be WebP/AVIF format for performance. Recommended: signage, apparatus room, training sessions (with student consent), and batch activities.
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {Array.from({ length: 12 }).map((_, i) => (
          <div class="aspect-square bg-gray-100 rounded-xl border border-gray-200 flex items-center justify-center text-gray-400 text-xs text-center p-3">
            <div>
              <svg class="w-8 h-8 mx-auto mb-1 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Photo {i + 1}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <WhatsAppButton />
</BaseLayout>
