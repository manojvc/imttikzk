---
import facts from '@data/facts.json';
const { centre, brand, courses } = facts;
---

<footer class="bg-brand-900 text-gray-300">
  <!-- Logo strip -->
  <div class="bg-brand-950 border-b border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center gap-4 justify-between">
      <div class="flex items-center gap-4">
        <img src="/images/imtti-logo-official.png" alt="IMTTI Logo" class="h-12 w-auto object-contain brightness-0 invert opacity-80" />
        <div>
          <div class="text-white font-display font-bold text-base">IMTTI Kazhakkoottam</div>
          <div class="text-brand-300 text-xs">International Montessori Teacher Training Institute</div>
        </div>
      </div>
      <div class="flex gap-3">
        <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-lg transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
        <a href={`tel:${centre.phones.calls}`}
           class="flex items-center gap-2 px-4 py-2 border border-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- NAP – must match GBP exactly -->
      <div>
        <h3 class="text-gold-500 font-semibold text-sm uppercase tracking-wider mb-4">Our Centre</h3>
        <address class="not-italic text-sm space-y-2 leading-relaxed">
          <p class="text-gray-300">{centre.address.streetAddress},<br />{centre.address.addressLocality},<br />{centre.address.addressRegion} {centre.address.postalCode}</p>
          <p>
            <a href={`tel:${centre.phones.whatsapp}`} class="hover:text-gold-500 transition-colors">{centre.phones.whatsappDisplay}</a>
            <span class="text-brand-500 text-xs ml-1">(WhatsApp)</span>
          </p>
          <p>
            <a href={`tel:${centre.phones.calls}`} class="hover:text-gold-500 transition-colors">{centre.phones.callsDisplay}</a>
            <span class="text-brand-500 text-xs ml-1">(Calls)</span>
          </p>
          <p><a href={`mailto:${centre.email}`} class="hover:text-gold-500 transition-colors">{centre.email}</a></p>
          <p class="text-gray-500 text-xs">{centre.hoursDisplay}</p>
        </address>
      </div>

      <!-- Courses -->
      <div>
        <h3 class="text-gold-500 font-semibold text-sm uppercase tracking-wider mb-4">Courses</h3>
        <ul class="space-y-2 text-sm">
          {courses.map((c) => (
            <li>
              <a href={`/courses/${c.slug}/`} class="text-gray-400 hover:text-gold-400 transition-colors">{c.shortName}</a>
            </li>
          ))}
          <li><a href="/compare-courses/" class="text-gray-400 hover:text-gold-400 transition-colors">Compare All Courses</a></li>
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-gold-500 font-semibold text-sm uppercase tracking-wider mb-4">Information</h3>
        <ul class="space-y-2 text-sm">
          {[
            ['Admissions', '/admissions/'],
            ['Certification', '/certification/'],
            ['Placements', '/placements/'],
            ['Gallery', '/gallery/'],
            ['FAQ', '/faq/'],
            ['Blog', '/blog/'],
            ['About', '/about/'],
            ['Contact', '/contact/'],
          ].map(([label, href]) => (
            <li><a href={href} class="text-gray-400 hover:text-gold-400 transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Brand + Social -->
      <div>
        <h3 class="text-gold-500 font-semibold text-sm uppercase tracking-wider mb-4">About IMTTI</h3>
        <p class="text-sm text-gray-400 mb-4 leading-relaxed">
          Part of the <a href={brand.website} target="_blank" rel="noopener noreferrer" class="text-gold-500 hover:text-gold-400 transition-colors">IMTTI national network</a>,
          established {brand.established}. {brand.iso} certified, IAO-USA accredited.
        </p>
        <!-- Social icons – add links once handles are set up -->
        <div class="flex gap-2 flex-wrap">
          {[
            ['Instagram', centre.social.instagram, 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z'],
            ['Facebook', centre.social.facebook, 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z'],
            ['YouTube', centre.social.youtube, 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z'],
          ].map(([name, href, path]) => (
            href && href !== '{{TBD}}' ? (
              <a href={href} target="_blank" rel="noopener noreferrer" aria-label={name}
                 class="w-9 h-9 rounded-lg bg-brand-800 hover:bg-gold-700 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={path}/></svg>
              </a>
            ) : (
              <span class="w-9 h-9 rounded-lg bg-brand-800 opacity-40 flex items-center justify-center cursor-not-allowed" title={`Add ${name} handle`}>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={path}/></svg>
              </span>
            )
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-600">
      <p>© {new Date().getFullYear()} IMTTI Kazhakkoottam – International Montessori Teacher Training Institute. All rights reserved.</p>
      <p>Part of <a href={brand.website} target="_blank" rel="noopener noreferrer" class="hover:text-gray-400 transition-colors">IMTTI (imtti.org)</a></p>
    </div>
  </div>
</footer>
