---
import facts from '@data/facts.json';

interface Props {
  defaultCourse?: string;
  compact?: boolean;
}
const { defaultCourse = '', compact = false } = Astro.props;
const courses = facts.courses;
const endpoint = facts.enquiryFormEndpoint;
---

<form
  id="enquiry-form"
  data-endpoint={endpoint}
  class={`space-y-4 ${compact ? '' : 'bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8'}`}
  novalidate
>
  <div class={`grid gap-4 ${compact ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2'}`}>
    <div>
      <label for="ef-name" class="block text-sm font-medium text-gray-700 mb-1">Full Name <span class="text-red-500">*</span></label>
      <input
        id="ef-name" name="name" type="text" required autocomplete="name"
        class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
        placeholder="Your full name"
      />
    </div>
    <div>
      <label for="ef-phone" class="block text-sm font-medium text-gray-700 mb-1">Phone / WhatsApp <span class="text-red-500">*</span></label>
      <input
        id="ef-phone" name="phone" type="tel" required autocomplete="tel"
        pattern="[6-9][0-9]{9}"
        class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
        placeholder="10-digit mobile number"
      />
    </div>
    <div>
      <label for="ef-email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
      <input
        id="ef-email" name="email" type="email" autocomplete="email"
        class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
        placeholder="your@email.com"
      />
    </div>
    <div>
      <label for="ef-course" class="block text-sm font-medium text-gray-700 mb-1">Course Interested In</label>
      <select
        id="ef-course" name="course"
        class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
      >
        <option value="">— Select a course —</option>
        {courses.map((c) => (
          <option value={c.id} selected={c.id === defaultCourse}>{c.shortName}</option>
        ))}
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Mode</label>
      <div class="flex gap-4 mt-1">
        {['Offline', 'Online', 'Either'].map((m) => (
          <label class="flex items-center gap-1.5 text-sm text-gray-700 cursor-pointer">
            <input type="radio" name="mode" value={m.toLowerCase()} class="accent-brand-700" />
            {m}
          </label>
        ))}
      </div>
    </div>
    <div class={compact ? '' : 'sm:col-span-2'}>
      <label for="ef-message" class="block text-sm font-medium text-gray-700 mb-1">Message <span class="text-gray-400 font-normal">(optional)</span></label>
      <textarea
        id="ef-message" name="message" rows="3"
        class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition resize-none"
        placeholder="Any questions or specific details…"
      ></textarea>
    </div>
  </div>

  <!-- honeypot: hidden from humans, traps bots -->
  <input type="text" name="_honeypot" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div id="ef-error" class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2.5" role="alert"></div>
  <div id="ef-success" class="hidden text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-3 py-2.5" role="status">
    Thank you! We'll reach out to you shortly on WhatsApp/phone.
  </div>

  <button
    type="submit"
    id="ef-submit"
    class="w-full py-3 bg-brand-700 hover:bg-brand-800 disabled:opacity-60 text-white font-semibold rounded-xl transition-colors text-sm"
  >
    Send Enquiry
  </button>

  <p class="text-xs text-gray-400 text-center">
    Or <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer" class="text-green-600 hover:underline font-medium">chat directly on WhatsApp</a>
  </p>
</form>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorEl  = document.getElementById('ef-error')!;
      const successEl = document.getElementById('ef-success')!;
      const submitBtn = document.getElementById('ef-submit') as HTMLButtonElement;
      errorEl.classList.add('hidden');
      successEl.classList.add('hidden');

      // Honeypot check
      if ((form.querySelector('[name="_honeypot"]') as HTMLInputElement)?.value) return;

      const phone = (form.querySelector('#ef-phone') as HTMLInputElement).value;
      if (!/^[6-9][0-9]{9}$/.test(phone.replace(/\s/g, ''))) {
        errorEl.textContent = 'Please enter a valid 10-digit Indian mobile number.';
        errorEl.classList.remove('hidden');
        return;
      }

      const endpoint = form.dataset.endpoint ?? '';
      if (!endpoint || endpoint.startsWith('{{')) {
        console.log('Form data:', Object.fromEntries(new FormData(form)));
        successEl.classList.remove('hidden');
        form.reset();
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'form_submit', form_id: 'enquiry' });
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!res.ok) throw new Error('Server error');
        successEl.classList.remove('hidden');
        form.reset();
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'form_submit', form_id: 'enquiry' });
      } catch {
        errorEl.textContent = 'Something went wrong. Please try WhatsApp or call us directly.';
        errorEl.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Enquiry';
      }
    });
  }
</script>
