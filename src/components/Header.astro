---
import facts from '@data/facts.json';

const nav = [
  { label: 'Home', href: '/' },
  {
    label: 'Courses', href: '/courses/',
    children: [
      { label: 'PG Diploma – 1 Year',   href: '/courses/pg-diploma-montessori/' },
      { label: 'PG Diploma – 6 Months', href: '/courses/pg-diploma-montessori-6-month/' },
      { label: 'Diploma – 6 Months',    href: '/courses/diploma-montessori/' },
      { label: 'Compare Courses',       href: '/compare-courses/' },
    ],
  },
  { label: 'Certification', href: '/certification/' },
  { label: 'Placements',    href: '/placements/' },
  { label: 'About',         href: '/about/' },
  { label: 'Blog',          href: '/blog/' },
  { label: 'Contact',       href: '/contact/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white border-b-[3px] border-gold-500 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-2 gap-4">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0 group" aria-label="IMTTI Kazhakkoottam – Home">
        <img
          src="/images/imtti-logo-official.png"
          alt="IMTTI – International Montessori Teacher Training Institute"
          class="h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          loading="eager"
        />
        <div class="hidden md:block border-l-2 border-gold-500 pl-3">
          <div class="text-brand-700 font-display font-bold text-sm leading-tight">IMTTI Kazhakkoottam</div>
          <div class="text-gray-500 text-xs leading-tight">Montessori Teacher Training · Trivandrum</div>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-0.5 flex-1 justify-center" aria-label="Main navigation">
        {nav.map((item) =>
          item.children ? (
            <div class="relative group">
              <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 hover:text-brand-700 transition-colors rounded-md">
                {item.label}
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="absolute left-0 top-full mt-1 w-56 bg-white rounded-xl shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 overflow-hidden">
                {item.children.map((child) => (
                  <a href={child.href} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-700 hover:text-white transition-colors border-l-2 border-transparent hover:border-gold-500">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={`px-3 py-2 text-sm font-medium rounded-md transition-colors border-b-2 ${
                currentPath === item.href
                  ? 'text-brand-700 border-gold-500 font-semibold'
                  : 'text-gray-700 hover:text-brand-700 border-transparent hover:border-gold-400'
              }`}
            >
              {item.label}
            </a>
          )
        )}
      </nav>

      <!-- CTA buttons -->
      <div class="flex items-center gap-2 shrink-0">
        <a
          href={facts.whatsappCta}
          target="_blank" rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
        <a
          href={`tel:${facts.centre.phones.whatsapp}`}
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 bg-brand-700 hover:bg-brand-800 text-white text-sm font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call
        </a>

        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-md text-brand-700 hover:bg-brand-50 transition-colors" aria-label="Menu" aria-expanded="false">
          <svg id="ico-open"  class="w-5 h-5"        fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="ico-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white">
    <nav class="max-w-7xl mx-auto px-4 py-3 space-y-1">
      {nav.map((item) =>
        item.children ? (
          <div>
            <div class="px-3 py-1.5 text-xs font-bold text-gold-700 uppercase tracking-wider">{item.label}</div>
            {item.children.map((child) => (
              <a href={child.href} class="block px-5 py-2 text-sm text-brand-700 hover:bg-brand-50 rounded-md">{child.label}</a>
            ))}
          </div>
        ) : (
          <a href={item.href} class="block px-3 py-2 text-sm font-medium text-brand-700 hover:bg-brand-50 rounded-md">{item.label}</a>
        )
      )}
      <div class="pt-3 pb-1 flex flex-col gap-2 border-t border-gray-100">
        <a href={facts.whatsappCta} target="_blank" rel="noopener noreferrer" class="flex justify-center gap-2 py-2.5 bg-green-500 text-white font-semibold rounded-lg">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Us
        </a>
        <a href={`tel:${facts.centre.phones.whatsapp}`} class="flex justify-center gap-2 py-2.5 bg-brand-700 text-white font-semibold rounded-lg">
          Call Us – {facts.centre.phones.whatsappDisplay}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn   = document.getElementById('mobile-menu-btn');
  const menu  = document.getElementById('mobile-menu');
  const iOpen = document.getElementById('ico-open');
  const iClose= document.getElementById('ico-close');
  btn?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    iOpen?.classList.toggle('hidden');
    iClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!hidden));
  });
</script>
