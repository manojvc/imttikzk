---
import facts from '@data/facts.json';
---
<!-- Admissions-open strip (no specific dates – contact for details) -->
<div class="bg-brand-700 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-col sm:flex-row items-center justify-center gap-3 text-sm font-medium">
    <span>🎓 Admissions Open – Offline &amp; Online · Kazhakkoottam, Trivandrum</span>
    <a
      href={facts.whatsappCta}
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 bg-gold-500 text-brand-900 font-bold px-4 py-1 rounded-full text-xs hover:bg-gold-400 transition-colors"
    >
      WhatsApp for Batch Dates
    </a>
  </div>
</div>
